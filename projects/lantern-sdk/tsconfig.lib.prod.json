/* Production library build. LNTN-401: Ivy partial compilation (APF v13), see README "Build format"
 * and docs/adr/0001-angular-13-partial-ivy.md. Consumers link the declarations at build time. */
{
  "extends": "./tsconfig.lib.json",
  "compilerOptions": {
    "declarationMap": false
  },
  "angularCompilerOptions": {
    "compilationMode": "partial",
    "fullTemplateTypeCheck": true,
    "strictInjectionParameters": true,
    "enableResourceInlining": true
  }
}
